# Copy this file to .env and fill in the keys you want to use.
# Commands whose key is missing will reply with a clear "not configured" message
# instead of crashing.

# Required for the .ai command
ANTHROPIC_API_KEY=

# Required for .weather
OPENWEATHER_API_KEY=

# Required for .news
NEWSAPI_KEY=

# .tts, .trt, .url, .ss, .google, .lyrics need no API key — they use free public endpoints.

# Set to true to let the bot respond to your own messages (useful for solo testing
# with only one WhatsApp number). Leave false/unset for normal use.
ALLOW_SELF_TEST=true
